{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/Template.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss,fff} {ThreadId} {Level:u4} [{TraceId}] {Message} - {SourceContext}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithTraceId"
    ],
    "Properties": {
      "Application": "Template"
    }
  },
  "Database": {
    "Provider": "SQL Server",
    "ConnectionString": "Data Source=AILATUI25\\MSSQLSERVER01;Initial Catalog=TemplateDatabase;Persist Security Info=False;User ID=sa;Password=sa;Pooling=False;MultipleActiveResultSets=False;Connect Timeout=60;Encrypt=True;TrustServerCertificate=True",
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 30,
    "EnableQuerySplitting": true,
    "PoolSize": 128,
    "EnableHealthChecks": true,
    "HealthCheckInterval": 5
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "YOUR_JWT_SUPER_SECRET_KEY_MUST_BE_AT_LEAST_256_BITS_LONG_123456",
    "Issuer": "Template",
    "Audience": "Template-Users",
    "TokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  }
}